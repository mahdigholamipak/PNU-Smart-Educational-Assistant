# ============================================================
# PNU Smart Educational Assistant — Environment Configuration
# ============================================================

# ---------- Database ----------
# SQLite (default):
DATABASE_URL=sqlite:///./pnu_assistant.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/pnu_assistant

# ---------- Security (JWT) ----------
# IMPORTANT: Change this in production to a long random string.
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Gemini API ----------
# Single key or comma/newline-separated list for multi-key round-robin.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
GEMINI_OCR_MODEL=gemini-3.5-flash-lite

# ---------- Embedding Pipeline Tuning (rate-limit resiliency) ----------
# Number of chunks per embedding API call (batchEmbedContents).
EMBEDDING_BATCH_SIZE=20
# Seconds a key is "burned" after a 429 (skipped by the pool).
EMBEDDING_KEY_COOLDOWN=60
# Base delay (seconds) for exponential backoff when all keys are cooling.
EMBEDDING_BACKOFF_BASE=10.0
# Maximum retry attempts for a single embedding batch.
EMBEDDING_MAX_RETRIES=5
# Short sleep (seconds) between successive batches to avoid spiking RPM.
EMBEDDING_INTER_BATCH_DELAY=0.5

# ---------- Semantic/LRU Caching (token savings) ----------
# Master switch for all in-memory caches (embedding vectors, OCR text).
CACHE_ENABLED=true
# Max entries in the embedding LRU cache (per (query, model) key).
EMBEDDING_CACHE_SIZE=512
# Max entries in the OCR LRU cache (keyed by SHA-256 of the image bytes).
OCR_CACHE_SIZE=128

# ---------- ChromaDB ----------
CHROMA_PERSIST_DIR=./chroma_db

# ---------- Uploads ----------
UPLOAD_DIR=./uploads

# ---------- CORS ----------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000